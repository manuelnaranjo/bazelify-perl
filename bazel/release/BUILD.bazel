load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    ":rules.bzl",
    "perl_distribution",
    "perl_test_suite_archive",
    "platform_and_pthread_transition_filegroup",
)

package(default_visibility = ["//visibility:public"])

_CORE_XS_MODULES = [
    "@perl//:POSIX",
    "@perl//:Socket",
    "@perl//:Fcntl",
    "@perl//:IO",
    "@perl//:Cwd",
    "@perl//:File_Glob",
    "@perl//:List_Util",
    "@perl//:mro",
]

_ARCHNAME = select({
    "//bazel:is_linux_amd64": "x86_64-linux",
    "//bazel:is_linux_arm64": "aarch64-linux",
    "//bazel:is_osx_amd64": "darwin-2level",
    "//bazel:is_osx_arm64": "darwin-2level",
    "//conditions:default": "x86_64-linux",
})

_DLEXT = select({
    "//bazel:is_linux_amd64": "so",
    "//bazel:is_linux_arm64": "so",
    "//bazel:is_osx_amd64": "bundle",
    "//bazel:is_osx_arm64": "bundle",
    "//conditions:default": "so",
})

config_setting(
    name = "is_linux_amd64_nopthread",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flag_values = {
        "//bazel:use_pthread": "false",
    },
)

config_setting(
    name = "is_linux_arm64_nopthread",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    flag_values = {
        "//bazel:use_pthread": "false",
    },
)

config_setting(
    name = "is_osx_amd64_nopthread",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    flag_values = {
        "//bazel:use_pthread": "false",
    },
)

config_setting(
    name = "is_osx_arm64_nopthread",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    flag_values = {
        "//bazel:use_pthread": "false",
    },
)

_PLATFORM_NAME = select({
    ":is_linux_amd64_nopthread": "linux_amd64-nopthread",
    ":is_linux_arm64_nopthread": "linux_arm64-nopthread",
    ":is_osx_amd64_nopthread": "osx_amd64-nopthread",
    ":is_osx_arm64_nopthread": "osx_arm64-nopthread",
    "//bazel:is_linux_amd64": "linux_amd64",
    "//bazel:is_linux_arm64": "linux_arm64",
    "//bazel:is_osx_amd64": "osx_amd64",
    "//bazel:is_osx_arm64": "osx_arm64",
    "//conditions:default": "linux_amd64",
})

# Base distribution packaging target for the active target platform configuration
perl_distribution(
    name = "dist_pkg",
    archname = _ARCHNAME,
    build_dist = "//tools:build_dist.py",
    change_shebang = "//tools:change-shebang",
    config_git_pl = "@perl//:config_git_pl",
    config_heavy_pl = "@perl//:lib/Config_heavy.pl",
    config_pm = "@perl//:lib/Config.pm",
    dlext = _DLEXT,
    library_files = ["@perl//:perl_library_files"],
    miniperl = "@perl//:miniperl",
    patch_config = "//tools:patch_config.py",
    perl = "@perl//:perl",
    platform_name = _PLATFORM_NAME,
    sample_source = "@perl//:perl.c",
    sources = ["@perl//:sources"],
    version = "//bazel/perl:version",
    xs_extensions = _CORE_XS_MODULES,
)

# Cross-platform transitions: build for each target platform with and without pthread in a single invocation
platform_and_pthread_transition_filegroup(
    name = "dist_linux_amd64",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:linux_amd64",
    use_pthread = True,
)

platform_and_pthread_transition_filegroup(
    name = "dist_linux_amd64_nopthread",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:linux_amd64",
    use_pthread = False,
)

platform_and_pthread_transition_filegroup(
    name = "dist_linux_arm64",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:linux_arm64",
    use_pthread = True,
)

platform_and_pthread_transition_filegroup(
    name = "dist_linux_arm64_nopthread",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:linux_arm64",
    use_pthread = False,
)

platform_and_pthread_transition_filegroup(
    name = "dist_osx_amd64",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:osx_amd64",
    use_pthread = True,
)

platform_and_pthread_transition_filegroup(
    name = "dist_osx_amd64_nopthread",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:osx_amd64",
    use_pthread = False,
)

platform_and_pthread_transition_filegroup(
    name = "dist_osx_arm64",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:osx_arm64",
    use_pthread = True,
)

platform_and_pthread_transition_filegroup(
    name = "dist_osx_arm64_nopthread",
    srcs = [":dist_pkg"],
    target_platform = "//bazel:osx_arm64",
    use_pthread = False,
)

# Hermetic packaging of upstream Perl unit test suite sources
perl_test_suite_archive(
    name = "test_suite_pkg",
    output_name = "perl-test-suite.tar.gz",
    package_tool = "//tools:package_test_suite.py",
    sample_source = "@perl//:perl.c",
    sources = ["@perl//:sources"],
)

# Aggregated distribution target that packages all 4 target platforms (both with and without pthread) and the test suite archive
filegroup(
    name = "dist",
    srcs = [
        ":dist_linux_amd64",
        ":dist_linux_amd64_nopthread",
        ":dist_linux_arm64",
        ":dist_linux_arm64_nopthread",
        ":dist_osx_amd64",
        ":dist_osx_amd64_nopthread",
        ":dist_osx_arm64",
        ":dist_osx_arm64_nopthread",
        ":test_suite_pkg",
    ],
)

# Test verifying runtime relocatability and execution in an arbitrary directory (with pthread)
sh_test(
    name = "verify_dist_test",
    size = "small",
    srcs = ["verify_dist_test.sh"],
    args = ["$(rootpaths :dist_linux_amd64)"],
    data = [
        ":dist_linux_amd64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Test verifying runtime relocatability and execution in an arbitrary directory (without pthread)
sh_test(
    name = "verify_dist_nopthread_test",
    size = "small",
    srcs = ["verify_dist_test.sh"],
    args = ["$(rootpaths :dist_linux_amd64_nopthread)"],
    data = [
        ":dist_linux_amd64_nopthread",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Test executing the upstream Perl unit test suite across core modules (with pthread)
sh_test(
    name = "upstream_unit_test",
    size = "medium",
    srcs = ["run_upstream_tests.sh"],
    args = [
        "$(rootpaths :dist_linux_amd64)",
        "$(rootpaths :test_suite_pkg)",
    ],
    data = [
        ":dist_linux_amd64",
        ":test_suite_pkg",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Test executing the upstream Perl unit test suite across core modules (without pthread)
sh_test(
    name = "upstream_unit_nopthread_test",
    size = "medium",
    srcs = ["run_upstream_tests.sh"],
    args = [
        "$(rootpaths :dist_linux_amd64_nopthread)",
        "$(rootpaths :test_suite_pkg)",
    ],
    data = [
        ":dist_linux_amd64_nopthread",
        ":test_suite_pkg",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
