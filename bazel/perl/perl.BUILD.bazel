# Overlay BUILD file for Perl 5.45.4 distribution
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**"]))

# All sources in upstream Perl distribution
filegroup(
    name = "sources",
    srcs = glob(["**"]),
)

# Header files
filegroup(
    name = "headers",
    srcs = glob([
        "*.h",
        "cpan/**/*.h",
        "dist/**/*.h",
        "ext/**/*.h",
    ]),
)

# C source translation units
filegroup(
    name = "c_sources",
    srcs = glob([
        "*.c",
        "cpan/**/*.c",
        "dist/**/*.c",
        "ext/**/*.c",
    ]),
)

# Pre-staged generated C sources and headers from upstream CPAN release
filegroup(
    name = "generated_c_sources",
    srcs = [
        "keywords.c",
        "opcode.h",
        "opnames.h",
        "regnodes.h",
    ],
)

# Host generator tool for uudmap.h, bitcount.h, and mg_data.h
cc_binary(
    name = "generate_uudmap",
    srcs = [
        "generate_uudmap.c",
        "mg_raw.h",
    ],
)

# Action to regenerate uudmap.h, bitcount.h, and mg_data.h
genrule(
    name = "regenerate_headers",
    outs = [
        "bitcount.h",
        "mg_data.h",
        "uudmap.h",
    ],
    cmd = "$(execpath :generate_uudmap) $(OUTS)",
    tools = [":generate_uudmap"],
)

# Automatically generate git_version.h for release build
genrule(
    name = "git_version_h",
    outs = ["git_version.h"],
    cmd = """cat > $@ << 'EOF'
/**************************************************************************
* WARNING: 'git_version.h' is automatically generated
*          DO NOT EDIT DIRECTLY - edit make_patchnum.pl instead
***************************************************************************/
#define PERL_GIT_UNPUSHED_COMMITS		\\
    /*leave-this-comment*/
EOF
""",
)

# Miniperl-specific variants of op.c, perl.c, and universal.c
genrule(
    name = "opmini_c",
    srcs = ["op.c"],
    outs = ["opmini.c"],
    cmd = "cp $< $@",
)

genrule(
    name = "perlmini_c",
    srcs = ["perl.c"],
    outs = ["perlmini.c"],
    cmd = "cp $< $@",
)

genrule(
    name = "universalmini_c",
    srcs = ["universal.c"],
    outs = ["universalmini.c"],
    cmd = "cp $< $@",
)

filegroup(
    name = "perl_library_files",
    srcs = glob(
        [
            "lib/**/*.pm",
            "lib/**/*.pl",
            "cpan/**/*.pm",
            "cpan/**/*.pl",
            "dist/**/*.pm",
            "dist/**/*.pl",
            "ext/**/*.pm",
            "ext/**/*.pl",
        ],
        allow_empty = True,
    ),
)

genrule(
    name = "generate_configpm",
    srcs = [
        "configpm",
        "Porting/Glossary",
        "myconfig.SH",
        "@@//bazel/config:config_sh",
    ] + glob(["lib/**/*.pm", "lib/**/*.pl"]),
    outs = [
        "lib/Config.pm",
        "lib/Config_heavy.pl",
        "lib/Config.pod",
    ],
    cmd = """
        ROOT=$$(pwd)/$$(dirname $(location Porting/Glossary))/..
        cp $(location @@//bazel/config:config_sh) $$ROOT/config.sh
        (cd $$ROOT && $$OLDPWD/$(location :miniperl) -Ilib configpm)
        cp $$ROOT/lib/Config.pm $(location lib/Config.pm)
        cp $$ROOT/lib/Config_heavy.pl $(location lib/Config_heavy.pl)
        cp $$ROOT/lib/Config.pod $(location lib/Config.pod)
    """,
    tools = [":miniperl"],
)

genrule(
    name = "generate_dynaloader_c",
    srcs = [
        "configpm",
        "ext/DynaLoader/dl_dlopen.xs",
        "lib/ExtUtils/typemap",
        "dist/ExtUtils-ParseXS/lib/ExtUtils/xsubpp",
        ":perl_library_files",
        ":generate_configpm",
    ],
    outs = ["ext/DynaLoader/DynaLoader.c"],
    cmd = """
        PERL_ROOT=$$(pwd)/$$(dirname $(location configpm))
        CFGDIR=$$(dirname $$(echo '$(locations :generate_configpm)' | awk '{print $$1}'))
        INCS="-I$$CFGDIR"
        for d in $$PERL_ROOT/lib $$PERL_ROOT/cpan/*/lib $$PERL_ROOT/dist/*/lib $$PERL_ROOT/ext/*/lib $$PERL_ROOT/cpan/* $$PERL_ROOT/dist/* $$PERL_ROOT/ext/*; do
            if [ -d "$$d" ]; then
                INCS="$$INCS -I$$d"
            fi
        done
        TYPEMAP=$$(pwd)/$(location lib/ExtUtils/typemap)
        XSUBPP=$$(pwd)/$(location dist/ExtUtils-ParseXS/lib/ExtUtils/xsubpp)
        XS=$$(pwd)/$(location ext/DynaLoader/dl_dlopen.xs)
        $$(pwd)/$(location :miniperl) $$INCS "$$XSUBPP" -noprototypes -typemap "$$TYPEMAP" "$$XS" > $@
    """,
    tools = [":miniperl"],
)

_CORE_COPTS = [
