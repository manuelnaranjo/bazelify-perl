cc_library(
    name = "perl_headers",
    hdrs = glob([
        "*.h",
        "*.inc",
    ]) + [
        ":git_version_h",
    ],
    textual_hdrs = [
        "perly.act",
        "perly.tab",
        "vutil.c",
        "ext/DynaLoader/dlutils.c",
    ],
    deps = [
        "@@//bazel/config:config_headers",
    ],
)

# miniperl binary
cc_binary(
    name = "miniperl",
    srcs = _COMMON_SRCS + [
        ":opmini_c",
        ":perlmini_c",
        ":universalmini_c",
        "miniperlmain.c",
    ],
    copts = _CORE_COPTS + [
        "-DPERL_IS_MINIPERL",
        "-DPERL_EXTERNAL_GLOB",
    ],
    linkopts = _SYSTEM_LIBS,
    deps = [
        ":perl_headers",
    ],
)

genrule(
    name = "generate_perlmain_c",
    srcs = [
        "configpm",
        ":perl_library_files",
        ":generate_configpm",
    ],
    outs = ["perlmain.c"],
    cmd = """
        PERL_ROOT=$$(pwd)/$$(dirname $(location configpm))
        CFGDIR=$$(dirname $$(echo '$(locations :generate_configpm)' | awk '{print $$1}'))
        INCS="-I$$CFGDIR"
        for d in $$PERL_ROOT/lib $$PERL_ROOT/cpan/*/lib $$PERL_ROOT/dist/*/lib $$PERL_ROOT/ext/*/lib $$PERL_ROOT/cpan/* $$PERL_ROOT/dist/* $$PERL_ROOT/ext/*; do
            if [ -d "$$d" ]; then
                INCS="$$INCS -I$$d"
            fi
        done
        $$(pwd)/$(location :miniperl) $$INCS -MExtUtils::Miniperl -e 'writemain(@ARGV)' DynaLoader > $@
    """,
    tools = [":miniperl"],
)

# libperl library
cc_library(
    name = "libperl",
    srcs = _COMMON_SRCS + [
        "op.c",
        "perl.c",
        "universal.c",
        ":generate_dynaloader_c",
    ],
    copts = _CORE_COPTS,
    deps = [
        ":perl_headers",
    ],
)

# perl binary
cc_binary(
    name = "perl",
    srcs = [
        ":generate_perlmain_c",
    ],
    copts = _CORE_COPTS,
    linkopts = _SYSTEM_LIBS + _PERL_LINKOPTS,
    deps = [
        ":libperl",
    ],
)

# Core C/XS Extension: POSIX
genrule(
    name = "generate_posix_c",
    srcs = [
        "configpm",
        "lib/ExtUtils/typemap",
        "dist/ExtUtils-ParseXS/lib/ExtUtils/xsubpp",
        ":perl_library_files",
        ":generate_configpm",
    ] + glob(["ext/POSIX/**/*"]),
    outs = [
        "ext/POSIX/POSIX.c",
        "ext/POSIX/const-c.inc",
    ],
    cmd = """
        PERL_ROOT=$$(pwd)/$$(dirname $(location configpm))
        CFGDIR=$$(dirname $$(echo '$(locations :generate_configpm)' | awk '{print $$1}'))
        TREE=$$(mktemp -d)
        mkdir -p $$TREE/lib/ExtUtils $$TREE/ext/POSIX
        touch $$TREE/config_h.SH $$TREE/perl.h $$TREE/cflags
        cp -r --no-preserve=mode $$PERL_ROOT/lib/* $$TREE/lib/
        cp -r --no-preserve=mode $$CFGDIR/* $$TREE/lib/
        for d in $$PERL_ROOT/cpan/*/lib/* $$PERL_ROOT/dist/*/lib/* $$PERL_ROOT/ext/*/lib/*; do
            if [ -e "$$d" ]; then cp -r --no-preserve=mode "$$d" $$TREE/lib/; fi
        done
        for d in $$PERL_ROOT/cpan/*/*.pm $$PERL_ROOT/dist/*/*.pm $$PERL_ROOT/ext/*/*.pm; do
            if [ -f "$$d" ]; then cp --no-preserve=mode "$$d" $$TREE/lib/; fi
        done
        cp -r --no-preserve=mode $$PERL_ROOT/ext/POSIX/* $$TREE/ext/POSIX/
        MINIPERL=$$(pwd)/$(location :miniperl)
        (cd $$TREE/ext/POSIX && PERL_CORE=1 $$MINIPERL -I../../lib Makefile.PL && $$MINIPERL -I../../lib $$PERL_ROOT/dist/ExtUtils-ParseXS/lib/ExtUtils/xsubpp -noprototypes -typemap $$PERL_ROOT/lib/ExtUtils/typemap -typemap typemap POSIX.xs > POSIX.c)
        cp $$TREE/ext/POSIX/POSIX.c $(location ext/POSIX/POSIX.c)
        cp $$TREE/ext/POSIX/const-c.inc $(location ext/POSIX/const-c.inc)
        rm -rf $$TREE
    """,
    tools = [":miniperl"],
)

cc_binary(
    name = "POSIX",
    srcs = [
        ":generate_posix_c",
    ],
    copts = _EXTENSION_COPTS + [
        "-iquote",
        "external/+perl_dist+perl/ext/POSIX",
        "-iquote",
        "ext/POSIX",
    ],
    linkopts = _EXTENSION_LINKOPTS + ["-lm"],
    linkshared = True,
    deps = [
        ":perl_headers",
    ],
)

