    "-fno-strict-aliasing",
    "-pipe",
    "-fstack-protector-strong",
    "-D_LARGEFILE_SOURCE",
    "-D_FILE_OFFSET_BITS=64",
    "-std=c99",
    "-Wall",
    "-Werror=pointer-arith",
    "-Werror=vla",
    "-Wextra",
    "-Wno-long-long",
    "-Wno-declaration-after-statement",
    "-Wno-nonnull-compare",
    "-Wc++-compat",
    "-Wwrite-strings",
    "-iquote",
    "external/+perl_dist+perl",
    "-iquote",
    "external/+perl_dist+perl/ext/DynaLoader",
    "-iquote",
    ".",
    "-iquote",
    "ext/DynaLoader",
]

_EXTENSION_COPTS = [
    "-fwrapv",
    "-fno-strict-aliasing",
    "-pipe",
    "-fstack-protector-strong",
    "-D_LARGEFILE_SOURCE",
    "-D_FILE_OFFSET_BITS=64",
    "-std=c99",
    "-Wall",
    "-Werror=pointer-arith",
    "-Werror=vla",
    "-Wextra",
    "-Wno-long-long",
    "-Wno-declaration-after-statement",
    "-Wno-nonnull-compare",
    "-Wc++-compat",
    "-Wwrite-strings",
    "-iquote",
    "external/+perl_dist+perl",
    "-iquote",
    ".",
]

_SYSTEM_LIBS = select({
    "@@//bazel:is_osx_amd64": [
        "-lpthread",
        "-ldl",
        "-lm",
        "-lc",
    ],
    "@@//bazel:is_osx_arm64": [
        "-lpthread",
        "-ldl",
        "-lm",
        "-lc",
    ],
    "//conditions:default": [
        "-lpthread",
        "-ldl",
        "-lm",
        "-lutil",
        "-lc",
