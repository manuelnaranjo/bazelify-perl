# Helper: ppport.h generator
genrule(
    name = "generate_ppport_h",
    srcs = [
        "configpm",
        ":perl_library_files",
        ":generate_configpm",
    ] + glob(["dist/Devel-PPPort/**/*"]),
    outs = ["dist/Devel-PPPort/ppport.h"],
    cmd = """
        PERL_ROOT=$$(pwd)/$$(dirname $(location configpm))
        CFGDIR=$$(dirname $$(echo '$(locations :generate_configpm)' | awk '{print $$1}'))
        TMP_DIR=$$(mktemp -d)
        cp -r --no-preserve=mode $$PERL_ROOT/dist/Devel-PPPort/* $$TMP_DIR/
        MINIPERL=$$(pwd)/$(location :miniperl)
        (cd $$TMP_DIR && $$MINIPERL -I$$CFGDIR -I$$PERL_ROOT/lib PPPort_pm.PL && $$MINIPERL -I$$CFGDIR -I$$PERL_ROOT/lib -I. ppport_h.PL)
        cp $$TMP_DIR/ppport.h $@
        rm -rf $$TMP_DIR
    """,
    tools = [":miniperl"],
)

