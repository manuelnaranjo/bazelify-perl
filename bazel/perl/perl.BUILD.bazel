})

_EXTENSION_LINKOPTS = select({
    "@@//bazel:is_osx_amd64": ["-undefined", "dynamic_lookup"],
    "@@//bazel:is_osx_arm64": ["-undefined", "dynamic_lookup"],
    "//conditions:default": [],
})

