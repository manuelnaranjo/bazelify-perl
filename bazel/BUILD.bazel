load("@platforms_contrib//os/linux/libc/glibc:glibc.bzl", "glibc_version_constraints")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["patches/**"]))

# Target platforms
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:gnu.2.28",
    ] + glibc_version_constraints("2.28"),
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "@llvm//constraints/libc:gnu.2.28",
    ] + glibc_version_constraints("2.28"),
)

platform(
    name = "osx_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "osx_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

# Remote execution platform targeting BuildBuddy Ubuntu 24.04 container image
platform(
    name = "ubuntu24_04_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "Arch": "",
        "OSFamily": "",
        "dockerNetwork": "",
    },
    parents = ["@buildbuddy_toolchain//:platform"],
)
